# Server
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="mongodb://localhost:27017/heptome"
# Production example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/heptome

# JWT
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Frontend
FRONTEND_URL=http://localhost:3000
SUPPORT_PHONE=+91 80501 71547

# AI provider
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4-turbo-preview
AI_BASE_URL=https://api.openai.com/v1

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@heptome.in

# Payment (server-side credentials only; never use NEXT_PUBLIC_* for these)
PAYMENT_PROVIDER=razorpay
PAYMENT_MODE=test
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public backend origin used in webhook documentation
BACKEND_PUBLIC_URL=http://localhost:5000
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp (optional)
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMS / Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Storage (optional)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
